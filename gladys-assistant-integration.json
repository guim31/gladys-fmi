    {
      "key": "test_connection",
      "label": {
        "en": "Test FMI",
        "fr": "Tester FMI",
        "de": "FMI testen",
        "es": "Probar FMI"
      },
      "description": {
        "en": "Fetches the weather of your first house and shows its current temperature, its station and its warnings.",
        "fr": "Récupère la météo de votre première maison et affiche sa température actuelle, sa station et ses vigilances.",
        "de": "Ruft das Wetter deines ersten Zuhauses ab und zeigt die aktuelle Temperatur, die Station und die Warnungen.",
        "es": "Obtiene el tiempo de su primera vivienda y muestra su temperatura actual, su estación y sus avisos."
      },
      "timeout_seconds": 20
    }
  ],
